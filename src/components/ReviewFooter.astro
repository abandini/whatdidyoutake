---
// SPEC 2 §11.4 — named clinical review on every medical claim, with credentials
// published. Where a page is unreviewed, the page says so, visibly, rather than
// letting an absent byline read as an implicit one.
import { getEntry } from 'astro:content';

interface Props { lastReviewed: Date; reviewedBy?: string; }
const { lastReviewed, reviewedBy } = Astro.props;
const reviewer = reviewedBy ? await getEntry('reviewers', reviewedBy) : undefined;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
{!reviewer && (
  <p class="unreviewed">
    <strong>No clinician has reviewed this page.</strong> It was written from the published
    literature; every claim is cited, and every citation is checked against PubMed or Crossref on
    each build. Any first-aid instruction follows published guidance from the organisations named
    beside it. That is the standard this site holds itself to, and it is not the same thing as a
    doctor having read this page — you should know which one you are getting.
  </p>
)}
<p class="review-note">
  {reviewer && (
    <>
      Clinically reviewed by <strong>{reviewer.data.name}</strong>, {reviewer.data.credentials} —
      {' '}{reviewer.data.role}. Declared conflicts: {reviewer.data.conflicts}.<br />
    </>
  )}
  Last reviewed <time datetime={lastReviewed.toISOString().slice(0, 10)}>{fmt.format(lastReviewed)}</time>.
  {' '}Found something wrong? <a href="/about/corrections">Corrections are published, not silently edited</a>.
</p>
