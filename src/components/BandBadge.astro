---
// SPEC 2 §14 — five bands, distinguishable by non-colour means as well:
// a distinct shape, the band name in words, and its position in the scale.
import { bandByKey, BANDS } from '../lib/rating-system.js';

interface Props { band: string; showRank?: boolean; }
const { band, showRank = true } = Astro.props;
const b = bandByKey(band);
if (!b) throw new Error(`Unknown band "${band}"`);

const SHAPES: Record<string, string> = {
  circle: '<circle cx="8" cy="8" r="6" />',
  square: '<rect x="2.5" y="2.5" width="11" height="11" />',
  diamond: '<path d="M8 1.5 14.5 8 8 14.5 1.5 8Z" />',
  triangle: '<path d="M8 1.8 14.8 14H1.2Z" />',
  octagon: '<path d="M5.3 1.6h5.4L14.4 5.3v5.4L10.7 14.4H5.3L1.6 10.7V5.3Z" />',
};
---
<span class={`band band--${b.key}`}>
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
       stroke="currentColor" stroke-width="1.6" fill-opacity="0.28" set:html={SHAPES[b.shape]} />
  <span>{b.label}</span>
  {showRank && <span class="band-rank">({b.rank} of {BANDS.length})</span>}
</span>
